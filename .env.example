# ====== Genel ======
NODE_ENV=development
PROJECT_NAME=seyyare

# ====== PostgreSQL ======
POSTGRES_USER=seyyare
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=seyyare
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ====== PostgREST ======
POSTGREST_PORT=3000
PGRST_DB_URI=postgres://seyyare:change_me_in_production@postgres:5432/seyyare
PGRST_DB_ANON_ROLE=anon
PGRST_DB_AUTHENTICATOR_ROLE=authenticator
PGRST_JWT_SECRET=please_generate_a_strong_secret_at_least_32_chars_long
PGRST_JWT_EXP=3600

# ====== Redis ======
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ====== MinIO ======
MINIO_ROOT_USER=seyyare_admin
MINIO_ROOT_PASSWORD=change_me_in_production
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ====== AI Service ======
AI_SERVICE_PORT=4000
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ====== Orchestrator (Multi-Agent) ======
ORCHESTRATOR_PORT=4050

# ====== Auth Service ======
AUTH_SERVICE_PORT=5000
JWT_SECRET=please_generate_a_strong_secret_at_least_32_chars_long
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ====== Nginx ======
DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443

# ====== Mobil (Expo) ======
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_AI_URL=http://localhost:4000
EXPO_PUBLIC_AUTH_URL=http://localhost:5000
EXPO_PUBLIC_MINIO_URL=http://localhost:9000