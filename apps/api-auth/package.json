{
  "name": "@seyyare/api-auth",
  "version": "0.1.0",
  "private": true,
  "description": "Seyyare.men authentication service (JWT + bcrypt + refresh tokens)",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "pg": "^8.13.0",
    "ioredis": "^5.4.1",
    "bcrypt": "^5.1.1",
    "zod": "^3.23.8",
    "jsonwebtoken": "^9.0.2",
    "pino-pretty": "^11.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "eslint": "^9.12.0"
  }
